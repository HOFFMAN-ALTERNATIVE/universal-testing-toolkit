# Target under test. Leave empty to test the bundled demo app.
BASE_URL=
API_BASE=/api

# Page lists (comma-separated paths)
SMOKE_PATHS=/,/about,/products,/contact
A11Y_PATHS=/,/about,/products,/contact
VISUAL_PATHS=/,/about,/contact
CONTACT_PATH=/contact          # set empty to skip form tests
CRAWL_LIMIT=50
CHECK_EXTERNAL_LINKS=0

# Accessibility standard
A11Y_TAGS=wcag2a,wcag2aa,wcag21a,wcag21aa

# Lighthouse
LHCI_PATHS=/,/about,/contact
LHCI_RUNS=3
LHCI_PRESET=desktop            # or mobile

# k6
PAGES=/,/about,/products
VUS=20
SCALE=1                        # 0.1 = 10x shorter profiles
SOAK_SECONDS=10800
